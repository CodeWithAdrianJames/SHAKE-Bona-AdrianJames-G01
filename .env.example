# ==============================================================================
# SHAKE (Structured Handling and Automated Knowledge Extraction)
# Environment Configuration Template
# Copy this file to `.env` and fill in your actual credentials.
# ==============================================================================

# Django Core Settings
SECRET_KEY=replace-with-a-secure-django-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ------------------------------------------------------------------------------
# Option A: PostgreSQL / Supabase Connection URI (Recommended for Supabase)
# Leave blank if using individual DB_* variables in Option B below.
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# ------------------------------------------------------------------------------
DATABASE_URL=
DB_SSL_REQUIRE=True

# ------------------------------------------------------------------------------
# Option B: Individual PostgreSQL / Supabase Connection Variables
# Used automatically when DATABASE_URL is not set.
# ------------------------------------------------------------------------------
DB_NAME=postgres
DB_USER=postgres.your_supabase_project_ref
DB_PASSWORD=your_database_password_here
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_SSLMODE=require
