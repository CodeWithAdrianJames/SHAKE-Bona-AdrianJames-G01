# Django Core Settings
SECRET_KEY=replace-with-a-secure-django-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ------------------------------------------------------------------------------
# Database Configuration (Optional)
# Leave unset to use local db.sqlite3 for development/testing; set to postgresql://... for Neon/PostgreSQL
# Example: postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# DB_SSL_REQUIRE=True
